{
  "name": "jarvis",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @jarvis/db db:generate",
    "db:migrate": "pnpm --filter @jarvis/db db:migrate",
    "db:deploy": "pnpm --filter @jarvis/db db:deploy",
    "db:seed": "pnpm --filter @jarvis/db db:seed",
    "db:clear-mock": "pnpm --filter @jarvis/db db:clear-mock",
    "db:studio": "pnpm --filter @jarvis/db db:studio",
    "db:reset": "pnpm --filter @jarvis/db db:reset",
    "auth:create-user": "pnpm --filter @jarvis/api auth:create-user"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
