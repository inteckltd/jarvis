# Jarvis environment. Copy to .env at the repo root; all apps read this one file.
# Never commit .env. Values marked "later" are not needed until that feature is built.

# --- Jarvis database (Jarvis's OWN Supabase project, not a client's) --------
# Supabase dashboard → Connect. Copy the host EXACTLY (it may be aws-0-… or aws-1-…,
# and must match your project's region), then append the query params shown here.
# URL-encode special characters in the password (e.g. @ → %40).
# Runtime: transaction pooler (port 6543). Keep ?pgbouncer=true&schema=jarvis.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&schema=jarvis"
# Migrations (and pg-boss later): session pooler (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?schema=jarvis"

# --- Supabase Auth (same Jarvis project) -------------------------------------
# Dashboard → Project Settings → API. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Used by `pnpm auth:create-user`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# The only email allowed to sign in.
ALLOWED_EMAIL="you@inteck.co.uk"

# --- Jarvis API (apps/api) ---------------------------------------------------
API_URL="http://localhost:4000"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts stored credentials (AES-256-GCM). Used from step 4. Do not change once secrets are stored.
ENCRYPTION_KEY=""

# --- Provider tokens (Inteck-owned accounts, read-only scopes) — later -------
DO_API_TOKEN=""            # step 8  - DigitalOcean, read scope
SUPABASE_ACCESS_TOKEN=""   # step 9  - Supabase Management API personal access token
VERCEL_TOKEN=""            # step 10
VERCEL_TEAM_ID=""          # step 10 - optional, for team-owned projects
GITHUB_TOKEN=""            # step 11 - classic PAT: repo, read:org
EXPO_TOKEN=""              # step 12 - Expo robot/access token

# --- AI (step 15) ------------------------------------------------------------
AI_ENABLED="false"
AI_API_KEY=""
