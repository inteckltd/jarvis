{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "ALLOWED_EMAIL",
    "API_URL",
    "ENCRYPTION_KEY",
    "DO_API_TOKEN",
    "SUPABASE_ACCESS_TOKEN",
    "VERCEL_TOKEN",
    "VERCEL_TEAM_ID",
    "EXPO_TOKEN",
    "GITHUB_TOKEN",
    "AI_ENABLED",
    "AI_API_KEY",
    "PORT",
    "HOST",
    "LOG_LEVEL"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "@jarvis/db#db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["@jarvis/db#db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["@jarvis/db#db:generate"]
    },
    "typecheck": {
      "dependsOn": ["@jarvis/db#db:generate"]
    },
    "test": {
      "dependsOn": ["@jarvis/db#db:generate"]
    }
  }
}
